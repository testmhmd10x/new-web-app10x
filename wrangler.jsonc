{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "new-web-app10x",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fd8181d8-c22d-405a-8b19-4700516f7f8b","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "80dc86ad22bc41dfb2c99fd400b05a6e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
